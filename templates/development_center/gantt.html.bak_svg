{% extends "base/base.html" %}

{% block page_title %}مخطط جانت الاحترافي{% endblock %}
{% block page_subtitle %}مخطط زمني احترافي لمهام OPAL ERP{% endblock %}

{% block content %}

<link rel="stylesheet" href="https://unpkg.com/frappe-gantt/dist/frappe-gantt.css">

<div class="opal-card p-4 mb-4">
  <h3>📅 مخطط جانت الاحترافي</h3>
  <p class="text-muted mb-0">يعرض المهام حسب تاريخ البداية والنهاية ونسبة الإنجاز.</p>
</div>

<div class="opal-card p-3 mb-4">
  <div class="d-flex gap-2 flex-wrap justify-content-between align-items-center">
    <div>
      <button class="btn btn-sm btn-primary" onclick="changeView('Day')">يومي</button>
      <button class="btn btn-sm btn-primary" onclick="changeView('Week')">أسبوعي</button>
      <button class="btn btn-sm btn-primary" onclick="changeView('Month')">شهري</button>
    </div>
    <span class="text-muted">الألوان حسب حالة المهمة</span>
  </div>
</div>

<div class="opal-card p-3">
  <div id="gantt-wrapper">
    <div id="gantt">جاري تحميل مخطط جانت...</div>
  </div>
</div>

<script src="https://unpkg.com/frappe-gantt/dist/frappe-gantt.umd.js"></script>

<style>
#gantt-wrapper {
  background: linear-gradient(135deg, #020617, #0f172a);
  border-radius: 22px;
  padding: 18px;
  overflow-x: auto;
  border: 1px solid rgba(255,255,255,0.08);
}

#gantt {
  min-height: 520px;
  direction: ltr;
}

.gantt-container,
.gantt-container svg {
  background: #0f172a !important;
  border-radius: 18px;
}

.gantt .grid-header {
  fill: #0b1220 !important;
}

.gantt .grid-row {
  fill: #111827 !important;
}

.gantt .row-line,
.gantt .tick {
  stroke: rgba(255,255,255,0.10) !important;
}

.gantt .lower-text,
.gantt .upper-text,
.gantt .bar-label {
  fill: #f8fafc !important;
  font-family: Tahoma, Arial, sans-serif !important;
  font-size: 12px;
}

.gantt .today-highlight {
  fill: rgba(20,184,166,0.22) !important;
}

.gantt .bar {
  rx: 8;
  ry: 8;
  stroke: rgba(255,255,255,0.25);
  stroke-width: 1;
}

.gantt .bar-progress {
  fill: rgba(34,197,94,0.90) !important;
}

.gantt .bar-wrapper.todo .bar { fill: #64748b !important; }
.gantt .bar-wrapper.doing .bar { fill: #2563eb !important; }
.gantt .bar-wrapper.review .bar { fill: #f59e0b !important; }
.gantt .bar-wrapper.done .bar { fill: #16a34a !important; }
.gantt .bar-wrapper.overdue .bar { fill: #dc2626 !important; }

.gantt .popup-wrapper {
  background: #020617 !important;
  color: #f8fafc !important;
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 14px;
  direction: rtl;
  text-align: right;
  font-family: Tahoma, Arial, sans-serif;
  box-shadow: 0 18px 40px rgba(0,0,0,0.45);
}

.opal-gantt-popup h5 {
  margin: 0 0 8px 0;
  color: #22d3ee;
}

.opal-gantt-popup p {
  margin: 4px 0;
  color: #cbd5e1;
}

@media (max-width: 768px) {
  #gantt-wrapper {
    padding: 10px;
  }
  #gantt {
    min-width: 920px;
  }
}

/* OPAL Gantt readability hard fix */
.gantt-container svg,
.gantt .grid-background {
  background: #0b1220 !important;
  fill: #0b1220 !important;
}

.gantt .grid-header {
  fill: #111827 !important;
}

.gantt .grid-row {
  fill: #0f172a !important;
}

.gantt .today-highlight {
  fill: rgba(20,184,166,0.12) !important;
}

.gantt text,
.gantt .lower-text,
.gantt .upper-text,
.gantt .bar-label {
  fill: #ffffff !important;
  color: #ffffff !important;
  font-weight: 700 !important;
  paint-order: stroke;
  stroke: #020617;
  stroke-width: 3px;
  stroke-linejoin: round;
}

.gantt .bar-label {
  font-size: 13px !important;
}

.gantt .grid-header text,
.gantt .upper-text,
.gantt .lower-text {
  fill: #e2e8f0 !important;
  stroke: #020617;
  stroke-width: 2px;
}

.gantt .bar-wrapper .bar {
  stroke: #ffffff !important;
  stroke-width: 1.2px !important;
}

.gantt .popup-wrapper,
.opal-gantt-popup {
  background: #020617 !important;
  color: #f8fafc !important;
}

.opal-gantt-popup * {
  color: #f8fafc !important;
}

</style>

<script>
let ganttInstance = null;

const statusLabels = {
  todo: "لم يبدأ",
  doing: "قيد التنفيذ",
  review: "قيد المراجعة",
  done: "مكتملة"
};

const monthNames = {
  January: "يناير", February: "فبراير", March: "مارس", April: "أبريل",
  May: "مايو", June: "يونيو", July: "يوليو", August: "أغسطس",
  September: "سبتمبر", October: "أكتوبر", November: "نوفمبر", December: "ديسمبر"
};

function normalizeDate(value) {
  if (!value) return null;
  return String(value).slice(0, 10);
}

function decorateArabicMonths() {
  setTimeout(() => {
    document.querySelectorAll(".gantt .upper-text, .gantt .lower-text").forEach(el => {
      let text = el.textContent || "";
      Object.keys(monthNames).forEach(en => {
        text = text.replace(en, monthNames[en]);
      });
      el.textContent = text;
    });
  }, 300);
}

function changeView(mode) {
  if (ganttInstance) {
    ganttInstance.change_view_mode(mode);
    decorateArabicMonths();
  }
}

fetch("/development/gantt/data/")
  .then(response => response.json())
  .then(data => {
    const rows = Array.isArray(data) ? data : (data.tasks || []);
    const tasks = rows.map(t => {
      const status = t.status || "todo";
      const progress = Number(t.progress || 0);
      const overdue = t.end && new Date(t.end) < new Date() && status !== "done";

      return {
        id: String(t.id),
        name: `${t.name || t.title || "مهمة"} — ${progress}%`,
        start: normalizeDate(t.start || t.start_date),
        end: normalizeDate(t.end || t.due_date || t.end_date),
        progress: progress,
        dependencies: (t.dependencies || []).map(String).join(","),
        custom_class: overdue ? "overdue" : status,
        status_label: overdue ? "متأخرة" : (statusLabels[status] || status)
      };
    }).filter(t => t.start && t.end);

    if (!tasks.length) {
      document.getElementById("gantt").innerHTML = "<div class='text-center text-muted p-5'>لا توجد مهام لها تواريخ لعرضها في مخطط جانت.</div>";
      return;
    }

    document.getElementById("gantt").innerHTML = "";

    ganttInstance = new Gantt("#gantt", tasks, {
      view_mode: "Day",
      language: "ar",
      popup: function(task) {
        return `
          <div class="opal-gantt-popup">
            <h5>${task.name || "مهمة"}</h5>
            <p><strong>الحالة:</strong> ${task.custom_class || "-"}</p>
            <p><strong>البداية:</strong> ${task.start || "-"}</p>
            <p><strong>النهاية:</strong> ${task.end || "-"}</p>
            <p><strong>نسبة الإنجاز:</strong> ${task.progress || 0}%</p>
          </div>
        `;
      }
    });

    decorateArabicMonths();
  })
  .catch(error => {
    document.getElementById("gantt").innerHTML = "<div class='text-danger p-4'>تعذر تحميل بيانات مخطط جانت.</div>";
    console.error(error);
  });
</script>

{% endblock %}
EOF

python manage.py check
python manage.py test development_center
{% extends "base/base.html" %}

{% block page_title %}المواد الدراسية{% endblock %}
{% block page_subtitle %}إدارة المواد وربطها بالصفوف الدراسية{% endblock %}

{% block content %}
<div class="opal-card p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1">المواد الدراسية</h3>
            <p class="text-muted mb-0">تنظيم المواد حسب الصف والرمز والحالة</p>
        </div>
        <a href="{% url 'academics:subject_create' %}" class="btn btn-primary">
            + إضافة مادة
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>المادة</th>
                    <th>الرمز</th>
                    <th>الصف</th>
                    <th>الحالة</th>
                    <th class="text-center">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                {% for s in subjects %}
                <tr>
                    <td>{{ s.name }}</td>
                    <td>{{ s.code|default:"-" }}</td>
                    <td>{{ s.grade|default:"-" }}</td>
                    <td>
                        {% if s.is_active %}
                            <span class="badge bg-success">نشطة</span>
                        {% else %}
                            <span class="badge bg-secondary">غير نشطة</span>
                        {% endif %}
                    </td>
                    <td class="text-center">
                        <a href="{% url 'academics:subject_update' s.id %}" class="btn btn-sm btn-warning">تعديل</a>
                    </td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">لا توجد مواد دراسية.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
